<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CalendarioController">

    <top>
        <Label text="Calendario de Clases Grupales"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <GridPane fx:id="gridCalendario"
                  alignment="CENTER"
                  hgap="10"
                  vgap="10"
                  style="-fx-padding: 20;">
        </GridPane>
    </center>

</BorderPane>