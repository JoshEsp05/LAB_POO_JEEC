<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.MembresiaController"
           style="-fx-padding: 25;">

    <VBox spacing="20"
          alignment="TOP_CENTER"
          maxWidth="950">

        <!-- TÍTULO -->
        <Label text="Sistema de Membresías"
               styleClass="section-title"/>

        <!-- CARD -->
        <VBox spacing="15"
              alignment="CENTER"
              styleClass="card"
              maxWidth="500">

            <ComboBox fx:id="comboClientes"
                      promptText="Selecciona Cliente"
                      prefWidth="350"/>

            <ComboBox fx:id="comboPlanes"
                      promptText="Selecciona Plan"
                      prefWidth="350"/>

            <Button text="Asignar Membresía"
                    onAction="#asignarMembresia"
                    prefWidth="350"
                    styleClass="primary-button"/>

        </VBox>

        <!-- TABLA -->
        <TableView fx:id="tablaMembresias"
                   prefWidth="900"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="colCliente"
                             text="Cliente"
                             prefWidth="300"/>

                <TableColumn fx:id="colPlan"
                             text="Plan"
                             prefWidth="250"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="200"/>

            </columns>

        </TableView>

    </VBox>

</StackPane>